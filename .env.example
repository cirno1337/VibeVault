# Copy to .env and fill in. Placeholders only: never commit a real .env.
# Generate tokens with:  openssl rand -hex 32

# ---- required ----------------------------------------------------------------
# Full access (web UI + operators). >= 16 chars; "change-me" style values are rejected at start-up.
VIBEVAULT_ADMIN_TOKEN=
# Ingest-only tokens used by collectors: name=token[,name2=token2]. They can POST events and nothing else.
VIBEVAULT_INGEST_TOKENS=

# ---- network (docker-compose) ---------------------------------------------------
VIBEVAULT_BIND=127.0.0.1
VIBEVAULT_PORT=8787

# ---- storage / operations -------------------------------------------------------
# (set automatically in the container; override for local development)
# VIBEVAULT_DATABASE_URL=sqlite:///./data/vibevault.db
# VIBEVAULT_AUTO_MIGRATE=true
# VIBEVAULT_LOG_LEVEL=INFO
# VIBEVAULT_LOG_JSON=true

# ---- limits ---------------------------------------------------------------------
# VIBEVAULT_MAX_BODY_BYTES=8000000
# VIBEVAULT_MAX_BATCH_EVENTS=500
# VIBEVAULT_MAX_EVENT_CONTENT_BYTES=1000000

# ---- privacy --------------------------------------------------------------------
# Server-side redaction (defence in depth; collectors redact before sending). Keep true.
# VIBEVAULT_SERVER_REDACTION=true
# JSON file with extra rules: [{"name": "ticket", "pattern": "INTERNAL-\\d{4}"}]
# VIBEVAULT_REDACTION_RULES_FILE=

# ---- background jobs -------------------------------------------------------------
# VIBEVAULT_WORKER_ENABLED=true
# VIBEVAULT_JOB_MAX_ATTEMPTS=5
# VIBEVAULT_JOB_BACKOFF_BASE_SECONDS=30
# VIBEVAULT_JOB_BACKOFF_MAX_SECONDS=3600
# VIBEVAULT_JOB_BATCH_SIZE=200
# VIBEVAULT_JOB_STEP_BUDGET_SECONDS=20

# ---- AI providers (all optional; leave PROVIDERS empty to disable AI entirely) ----------
# Ordered preference list. "local" runs on your own hardware; groq/gemini are EXTERNAL services.
# VIBEVAULT_PROVIDERS=local,groq,gemini
# External providers stay blocked unless you explicitly allow sending (redacted) data to them:
# VIBEVAULT_ALLOW_EXTERNAL_AI=false
# VIBEVAULT_AUTO_ENQUEUE_AI=false
# Project classification (job classify_sessions): nightly at this local time; empty = only on demand.
# VIBEVAULT_CLASSIFY_AT=03:00
# VIBEVAULT_TIMEZONE=Europe/Warsaw
# VIBEVAULT_CLASSIFY_AUTO_APPLY_CONFIDENCE=0.85
# VIBEVAULT_CLASSIFY_MAX_CHARS=16000
# VIBEVAULT_CLASSIFY_BATCH=50
# Local llama.cpp server (OpenAI-compatible):
# VIBEVAULT_PROVIDER_LOCAL_BASE_URL=http://main-pc.tailnet.example:8080/v1
# VIBEVAULT_PROVIDER_LOCAL_MODEL=
# Groq / Gemini / DeepSeek (OpenAI-compatible endpoints; base URLs have built-in presets):
# VIBEVAULT_PROVIDER_GROQ_API_KEY=
# VIBEVAULT_PROVIDER_GROQ_MODEL=
# VIBEVAULT_PROVIDER_GROQ_DAILY_REQUEST_BUDGET=
# VIBEVAULT_PROVIDER_DEEPSEEK_API_KEY=
# VIBEVAULT_PROVIDER_DEEPSEEK_MODEL=deepseek-flash   # thinking is disabled by the preset
# VIBEVAULT_PROVIDER_<NAME>_EXTRA_BODY={}            # JSON merged into the request body
# VIBEVAULT_PROVIDER_GEMINI_API_KEY=
# VIBEVAULT_PROVIDER_GEMINI_MODEL=
