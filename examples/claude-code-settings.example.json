{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "vibevault-collector hook", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "vibevault-collector hook", "timeout": 5 }] }],
    "PostToolUse":      [{ "matcher": "*", "hooks": [{ "type": "command", "command": "vibevault-collector hook", "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "vibevault-collector hook", "timeout": 5 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "vibevault-collector hook", "timeout": 5 }] }]
  }
}
