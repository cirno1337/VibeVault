{
  "manifest_version": 3,
  "name": "VibeVault collector",
  "short_name": "VibeVault",
  "version": "0.1.0",
  "description": "Archives your own claude.ai and chatgpt.com conversations to your self-hosted VibeVault server.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "VibeVault" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
